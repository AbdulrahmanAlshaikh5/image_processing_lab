    "def translate_product_listing(listing):\n",
    "    texts = [listing[\"title\"], listing[\"description\"], *listing[\"reviews\"]]\n",
    "    predictions = translate_batch(texts)\n",
    "    result = dict(listing)\n",
    "    result[\"title\"] = predictions[0]\n",
    "    result[\"description\"] = predictions[1]\n",
    "    result[\"reviews\"] = predictions[2:]\n",
    "    notices = []\n",
    "    for text in texts:\n",
    "        tokens = normalize_text(text).split()\n",
    "        unknown = sorted({word for word in tokens if source_tokenizer.word_index.get(word, MAX_VOCAB) >= source_vocab})\n",
    "        if unknown:\n",
    "            notices.append({\"text\": text, \"unknown_words\": unknown})\n",
    "        if len(tokens) > SOURCE_LENGTH:\n",
    "            notices.append({\"text\": text, \"warning\": \"Input exceeds supported token length and is truncated.\"})\n",
    "    return result, notices\n",
    "\n",
    "listing = {\"sku\": \"BOOK-1001\", \"price\": 19.99, \"currency\": \"EUR\", \"title\": \"Buy this book.\", \"description\": \"This book is cheap.\", \"reviews\": [\"I like this book.\"]}\n",
