    "def detokenize_text(text):\n",
    "    return re.sub(r\"\\s+([.,])\", r\"\\1\", text)\n",
    "\n",
    "def translate_batch(sentences):\n",
    "    normalized = [normalize_text(sentence) for sentence in sentences]\n",
    "    source_ids = pad_sequences(source_tokenizer.texts_to_sequences(normalized), maxlen=SOURCE_LENGTH, padding=\"post\", truncating=\"post\")\n",
    "    encoded, state_h, state_c = encoder_model(source_ids, training=False)\n",
    "    encoded = tf.identity(encoded)\n",
    "    token = np.full((len(sentences), 1), start_id, dtype=np.int32)\n",
    "    finished = np.zeros(len(sentences), dtype=bool)\n",
    "    words = [[] for _ in sentences]\n",
    "    for _ in range(TARGET_LENGTH - 1):\n",
    "        predictions, state_h, state_c = decoder_step([tf.constant(token), state_h, state_c, encoded, tf.constant(source_ids != 0)], training=False)\n",
    "        probabilities = predictions.numpy()[:, 0, :]\n",
    "        probabilities[:, 0] = -1\n",
    "        probabilities[:, start_id] = -1\n",
    "        next_tokens = probabilities.argmax(axis=-1)\n",
    "        for index, next_token in enumerate(next_tokens):\n",
    "            if finished[index]:\n",
    "                continue\n",
    "            if next_token == end_id:\n",
    "                finished[index] = True\n",
    "            else:\n",
    "                words[index].append(target_tokenizer.index_word.get(int(next_token), \"[unk]\"))\n",
    "        token = np.where(finished, 0, next_tokens).astype(np.int32)[:, None]\n",
    "        if finished.all():\n",
    "            break\n",
    "    return [detokenize_text(\" \".join(tokens)) for tokens in words]\n",
    "\n",
    "test_predictions = []\n",
    "for start in range(0, len(test_pairs), 64):\n",
    "    test_predictions.extend(translate_batch([pair[0] for pair in test_pairs[start:start + 64]]))\n",
    "references = [detokenize_text(pair[1]) for pair in test_pairs]\n",
    "bleu = sacrebleu.corpus_bleu(test_predictions, [references])\n",
    "chrf = sacrebleu.corpus_chrf(test_predictions, [references])\n",
    "exact_match = float(np.mean([prediction == reference for prediction, reference in zip(test_predictions, references)]))\n",
    "print(f\"Held-out greedy BLEU: {bleu.score:.2f} / 100\")\n",
