    "keras.utils.set_random_seed(42)\n",
    "model = keras.Sequential([\n",
    "    keras.layers.Input(shape=(eng_padded.shape[1],)),\n",
    "    keras.layers.Embedding(input_dim=len(eng_word_index) + 1, output_dim=64),\n",
    "    keras.layers.LSTM(64),\n",
    "    keras.layers.RepeatVector(frn_padded.shape[1]),\n",
    "    keras.layers.LSTM(64, return_sequences=True),\n",
    "    keras.layers.TimeDistributed(keras.layers.Dense(len(frn_word_index) + 1, activation=\"softmax\"))\n",
    "])\n",
    "model.compile(optimizer=keras.optimizers.Adam(0.01), loss=\"sparse_categorical_crossentropy\", metrics=[\"accuracy\"])\n",
    "toy_history = model.fit(eng_padded, frn_padded, epochs=50, batch_size=1, verbose=0)\n",
    "toy_loss, toy_accuracy = model.evaluate(eng_padded, frn_padded, verbose=0)\n",
    "model.summary()\n",
    "print(f\"Training loss: {toy_loss:.4f}\")\n",
    "print(f\"Training token accuracy, including padding: {toy_accuracy:.4f}\")\n",
    "\n",
    "def translate_sentence(sentence, model, eng_tokenizer, frn_tokenizer):\n",
    "    sequence = eng_tokenizer.texts_to_sequences([sentence])\n",
    "    padded_sequence = pad_sequences(sequence, maxlen=eng_padded.shape[1])\n",
    "    probabilities = model(padded_sequence, training=False).numpy()\n",
    "    predicted_ids = np.argmax(probabilities, axis=-1)\n",
    "    words = [frn_tokenizer.index_word[int(index)] for index in predicted_ids[0] if int(index) in frn_tokenizer.index_word]\n",
    "    return \" \".join(words)\n",
    "\n",
    "for source, reference in zip(english_sentences, french_sentences):\n",
    "    print(\"\\nInput:\", source)\n",
    "    print(\"Reference:\", reference)\n",
    "    print(\"Toy model translation:\", translate_sentence(source, model, tokenizer_eng, tokenizer_frn))\n",
    "assert len(toy_history.history[\"loss\"]) == 50\n",
    "assert toy_history.history[\"loss\"][-1] < toy_history.history[\"loss\"][0]\n"
   ]
