    "source_tokenizer.fit_on_texts([pair[0] for pair in train_pairs])\n",
    "target_tokenizer.fit_on_texts([\"startseq \" + pair[1] + \" endseq\" for pair in train_pairs])\n",
    "source_vocab = min(MAX_VOCAB, len(source_tokenizer.word_index) + 1)\n",
    "target_vocab = min(MAX_VOCAB, len(target_tokenizer.word_index) + 1)\n",
    "start_id = target_tokenizer.word_index[\"startseq\"]\n",
    "end_id = target_tokenizer.word_index[\"endseq\"]\n",
    "\n",
    "def encode_pairs(pairs):\n",
    "    sources = source_tokenizer.texts_to_sequences([pair[0] for pair in pairs])\n",
    "    targets = target_tokenizer.texts_to_sequences([\"startseq \" + pair[1] + \" endseq\" for pair in pairs])\n",
    "    sources = pad_sequences(sources, maxlen=SOURCE_LENGTH, padding=\"post\", truncating=\"post\")\n",
    "    targets = pad_sequences(targets, maxlen=TARGET_LENGTH, padding=\"post\", truncating=\"post\")\n",
    "    return sources, targets[:, :-1], targets[:, 1:]\n",
    "\n",
    "source_train, decoder_train, target_train = encode_pairs(train_pairs)\n",
    "source_val, decoder_val, target_val = encode_pairs(val_pairs)\n",
    "source_test, decoder_test, target_test = encode_pairs(test_pairs)\n",
    "print(\"Source vocabulary:\", source_vocab, \"French vocabulary:\", target_vocab)\n",
    "print(\"Training tensor shapes:\", source_train.shape, decoder_train.shape, target_train.shape)\n",
    "\n",
    "def masked_token_loss(y_true, y_pred):\n",
    "    y_true = tf.cast(y_true, tf.int32)\n",
    "    mask = tf.cast(tf.not_equal(y_true, 0), tf.float32)\n",
    "    losses = keras.losses.sparse_categorical_crossentropy(y_true, y_pred)\n",
    "    return tf.math.divide_no_nan(tf.reduce_sum(losses * mask, axis=-1), tf.reduce_sum(mask, axis=-1))\n",
    "\n",
    "def masked_token_accuracy(y_true, y_pred):\n",
    "    y_true = tf.cast(y_true, tf.int32)\n",
    "    mask = tf.cast(tf.not_equal(y_true, 0), tf.float32)\n",
    "    matches = tf.cast(tf.equal(y_true, tf.argmax(y_pred, axis=-1, output_type=tf.int32)), tf.float32)\n",
    "    return tf.math.divide_no_nan(tf.reduce_sum(matches * mask, axis=-1), tf.reduce_sum(mask, axis=-1))\n"
