   "source": [
    "DATA_URL = \"https://raw.githubusercontent.com/Devicharith/Language_translation-english-french-/master/fra-eng.zip\"\n",
    "CORPUS_SHA256 = \"6d6ad9b2b0b4ce3d33688d36ffbecd8d0279c8bdafe7a0bc6c44bcc5adac8a92\"\n",
    "data_dir = Path(\"lab10_data\")\n",
    "data_dir.mkdir(exist_ok=True)\n",
    "archive_path = data_dir / \"fra-eng.zip\"\n",
    "if not archive_path.is_file():\n",
    "    response = requests.get(DATA_URL, timeout=120)\n",
    "    response.raise_for_status()\n",
    "    archive_path.write_bytes(response.content)\n",
    "with zipfile.ZipFile(archive_path) as archive:\n",
    "    raw_corpus = archive.read(\"fra.txt\")\n",
    "    license_text = archive.read(\"_about.txt\").decode(\"utf-8\")\n",
    "assert hashlib.sha256(raw_corpus).hexdigest() == CORPUS_SHA256\n",
    "(data_dir / \"CORPUS_ATTRIBUTION.txt\").write_text(license_text, encoding=\"utf-8\")\n",
    "\n",
    "def normalize_text(text):\n",
    "    text = unicodedata.normalize(\"NFKC\", text).lower().replace(\"’\", \"'\")\n",
    "    tokens = re.findall(r\"[^\\W_]+(?:'[^\\W_]+)*|[.!?,]\", text, flags=re.UNICODE)\n",
    "    return \" \".join(tokens)\n",
    "\n",
    "unique_pairs = {}\n",
    "raw_lines = raw_corpus.decode(\"utf-8\").splitlines()\n",
    "for line in raw_lines:\n",
    "    parts = line.split(\"\\t\")\n",
    "    if len(parts) < 2:\n",
    "        continue\n",
    "    source, target = normalize_text(parts[0]), normalize_text(parts[1])\n",
    "    if 2 <= len(source.split()) <= 8 and 2 <= len(target.split()) <= 10:\n",
    "        unique_pairs.setdefault(source, (source, target, parts[2] if len(parts) > 2 else \"\"))\n",
    "\n",
    "shopping_words = {\"buy\", \"price\", \"cost\", \"shop\", \"order\", \"pay\", \"sell\", \"delivery\", \"product\", \"quality\", \"cheap\", \"expensive\", \"customer\", \"money\", \"refund\", \"shipping\", \"book\"}\n",
    "domain = [pair for pair in unique_pairs.values() if shopping_words.intersection(pair[0].split())]\n",
    "other = [pair for pair in unique_pairs.values() if not shopping_words.intersection(pair[0].split())]\n",
    "rng = np.random.default_rng(42)\n",
    "domain_ids = rng.choice(len(domain), size=min(1000, len(domain)), replace=False)\n",
    "selected = [domain[int(index)] for index in domain_ids]\n",
    "other_ids = rng.choice(len(other), size=6000 - len(selected), replace=False)\n",
    "selected.extend(other[int(index)] for index in other_ids)\n",
    "rng.shuffle(selected)\n",
    "train_pairs, holdout_pairs = train_test_split(selected, test_size=0.2, random_state=42)\n",
    "val_pairs, test_pairs = train_test_split(holdout_pairs, test_size=0.5, random_state=42)\n",
    "train_sources = {pair[0] for pair in train_pairs}\n",
    "val_sources = {pair[0] for pair in val_pairs}\n",
    "test_sources = {pair[0] for pair in test_pairs}\n",
    "assert train_sources.isdisjoint(val_sources | test_sources)\n",
    "assert val_sources.isdisjoint(test_sources)\n",
    "assert len(selected) == len({pair[0] for pair in selected}) == 6000\n",
    "with (data_dir / \"selected_pairs_with_attribution.csv\").open(\"w\", encoding=\"utf-8\", newline=\"\") as handle:\n",
    "    writer = csv.writer(handle)\n",
    "    writer.writerow([\"English\", \"French\", \"Attribution\"])\n",
    "    writer.writerows(selected)\n",
    "print(\"Raw parallel lines:\", len(raw_lines))\n",
    "print(\"Eligible distinct sources:\", len(unique_pairs))\n",
    "print(\"Shopping-related selected pairs:\", len(domain_ids))\n",
    "print(\"Train / validation / test:\", len(train_pairs), len(val_pairs), len(test_pairs))\n",
    "print(\"Sample training pair:\", train_pairs[0][:2])\n"
